# Copy this file to .env and replace every placeholder before starting the stack.
# Never commit the resulting .env file.

DASHBOARD_API_URL=http://localhost:8080
DASHBOARD_ORIGIN=http://localhost:3000

GRAPH_TENANT_ID=replace-with-entra-tenant-id
GRAPH_CLIENT_ID=replace-with-entra-application-client-id
GRAPH_CLIENT_SECRET=replace-with-entra-client-secret

# Dedicated SharePoint site and document-library drive used for outgoing images.
# Create SHAREPOINT_FOLDER_PATH before sending images.
SHAREPOINT_SITE_ID=replace-with-sharepoint-site-id
SHAREPOINT_DRIVE_ID=replace-with-document-library-drive-id
SHAREPOINT_FOLDER_PATH=teams-integration/outgoing-images

ACCESSHUB_BASE_URL=https://access-hub.example.com
ACCESSHUB_APPLICATION_ID=replace-with-application-id
ACCESSHUB_CLIENT_ID=replace-with-client-id
ACCESSHUB_USERNAME=replace-with-service-account-username
ACCESSHUB_PASSWORD=replace-with-service-account-password
ACCESSHUB_JWT_SECRET_KEY=replace-with-a-long-random-jwt-signing-key
ACCESSHUB_JWT_ISSUER=https://access-hub.example.com
ACCESSHUB_JWT_AUDIENCE=teams-integration-service

POSTGRES_DB=teams_integration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET_NAME=teams-integration
